{
  "name": "autoanimedownloader-frontend",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run i18n:compile && vite dev",
    "build": "bun run i18n:compile && vite build",
    "preview": "vite preview",
    "check": "bun run i18n:compile && svelte-check --tsconfig ./tsconfig.json",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n",
    "test:unit": "bun run i18n:compile && vitest run tests/unit",
    "test:component": "bun run i18n:compile && vitest run tests/component",
    "test:smoke": "bun run i18n:compile && playwright test"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.9",
    "autoprefixer": "^10.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@lucide/svelte": "^1.70.0",
    "svelte-spa-router": "^4.0.2"
  },
  "overrides": {
    "rimraf": "^5.0.0",
    "glob": "^10.0.0"
  }
}
